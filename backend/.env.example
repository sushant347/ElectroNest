# Backend environment template for local desktop setup
#
# Copy this file to: backend/.env
# Then set variables in your shell/host environment.
# Note: manage.py auto-loads .env for local development. In production, use platform env vars.

# Core Django settings
SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to call backend APIs (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Database option A (recommended): PostgreSQL
# Example: postgresql://user:password@localhost:5432/electronestdb
DATABASE_URL=postgresql://postgres:password@localhost:5432/electronestdb

# Optional direct DB URL used during migrations when pooled URLs are involved.
# For local desktop setups, keep it same as DATABASE_URL.
DIRECT_URL=postgresql://postgres:password@localhost:5432/electronestdb

# Database option B: SQL Server Express fallback
# If DATABASE_URL is left empty, backend falls back to SQL Server settings in page/settings.py:
#   ENGINE = mssql
#   NAME = ElectroNestDB
#   HOST = .\\SQLEXPRESS
#   trusted_connection = yes
# DATABASE_URL=

# Optional: manage.py already defaults this to page.settings
# DJANGO_SETTINGS_MODULE=page.settings